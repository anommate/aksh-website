# AKSH environment settings (docs/requirements/AKSH_Technical_Requirements.md §13).
#
# Copy to .env.local for local work and fill in only what you need. Never commit
# real values. Nothing here uses the NEXT_PUBLIC_ prefix: settings stay on the
# server, and the browser receives only the subset in src/lib/config/public.ts.
#
# Settings are validated when the server starts (src/lib/config/schema.ts). An
# invalid value stops `next dev` / `next start` with a message naming the
# variable and the fix. An empty value counts as unset.

# Always required: development | preview | production.
# Local development needs only APP_MODE=development; no integration credentials.
APP_MODE=

# Canonical public origin (https, no path). Required when APP_MODE=production.
# The production domain is not decided yet (docs/audit/DECISIONS.md O-06).
SITE_URL=

# Content source. Only "repository" exists; leave unset for that default.
CONTENT_SOURCE=

# Clinic time zone as an IANA name. Required once date preferences are enabled.
CLINIC_TIMEZONE=

# Consultation adapter. "demo" is allowed in development and preview only and is
# refused in production. Leave unset and enquiries are treated as unavailable.
CONSULTATION_ADAPTER=

# Outbound enquiry timeouts in milliseconds (defaults 8000 and 3000). Together
# they must fit the 15000 ms enquiry handler deadline.
DESTINATION_TIMEOUT_MS=
LOOKUP_TIMEOUT_MS=

# ---------------------------------------------------------------------------
# Reserved for Milestone 4. Not read yet: rules are added with the approved
# consultation destination (O-05) and rate-limit store. Secrets must be long
# random values, unique per environment, and never committed.
# ---------------------------------------------------------------------------
# Exact origins allowed to call the enquiry API, comma-separated.
# ALLOWED_ORIGINS=
# Destination endpoint and credential, if the approved adapter needs them.
# CONSULTATION_API_URL=
# CONSULTATION_API_TOKEN=
# Signs the short-lived receipt proof cookie.
# RECEIPT_SIGNING_SECRET=
# Keys the idempotency payload fingerprints; stable across the retry window.
# IDEMPOTENCY_HMAC_SECRET=
# Distributed rate-limit driver and the key for IP-derived limit keys.
# RATE_LIMIT_DRIVER=
# RATE_LIMIT_HMAC_SECRET=
# Version of the approved contact-permission notice.
# CONSENT_NOTICE_VERSION=
# Notification recipients and templates are provider-specific and are added
# only if the approved destination does not deliver notifications itself.
