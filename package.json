    "validate:release": "node scripts/not-implemented.mjs validate:release"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "1.2.20",
    "lottie-web": "5.13.0",
    "lucide-react": "1.48.0",
    "motion": "14.1.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": "24.x"
  },
